{
  "expo": {
    "name": "HB Plus Workspace",
    "slug": "hbplus-workspace",
    "version": "1.0.0",
    "scheme": "hbplus",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fit.hbplus.workspace"
    },
    "android": {
      "package": "fit.hbplus.workspace",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "googleServicesFileNotice": "TODO: Set ios.googleServicesFile ('./GoogleService-Info.plist') and android.googleServicesFile ('./google-services.json') once native credentials are provided."
    }
  }
}
